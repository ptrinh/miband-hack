<template>
  <div class="page">
    <div class="back" onclick="goBack">
      <text class="back-label">‹ Back</text>
    </div>
    <div class="modes">
      <div class="mode {{mode === 'cards' ? 'mode-on' : ''}}" onclick="chooseCards">
        <text class="mode-label">Cards</text>
      </div>
      <div class="mode {{mode === 'quiz' ? 'mode-on' : ''}}" onclick="chooseQuiz">
        <text class="mode-label">Quiz</text>
      </div>
    </div>
    <list class="list">
      <list-item type="head" class="head-item">
        <text class="big">{{learned}}</text>
        <text class="sub">of {{total}} words learned</text>
        <div class="bar">
          <div class="fill" style="width: {{fill}}px;"></div>
        </div>
      </list-item>
      <list-item type="row" class="row" for="{{r in rows}}">
        <text class="row-label">{{r.label}}</text>
        <text class="row-value">{{r.value}}</text>
      </list-item>
      <list-item type="reset" class="reset-item">
        <div class="reset {{confirmReset ? 'warn' : ''}}" onclick="resetProgress">
          <text class="reset-label">{{confirmReset ? 'Tap again to reset' : 'Reset progress'}}</text>
        </div>
      </list-item>
      <list-item type="end" class="end-item">
        <text class="end"> </text>
      </list-item>
    </list>
  </div>
</template>

<script>
import storage from '@system.storage'
import router from '@system.router'

var STORAGE_KEY = 'sat-v1'
var QUIZ_KEY = 'sat-quiz'
var MODE_KEY = 'sat-mode'
var BAR_WIDTH = 160 // design px, matches .bar

export default {
  // router params (numbers arrive as strings on some runtimes)
  protected: {
    total: 0,
    seen: 0,
    learned: 0,
    mastered: 0,
    due: 0,
    boxes: '',
    mode: 'cards',
    quizAnswered: 0,
    quizCorrect: 0,
    quizBest: 0
  },

  private: {
    fill: 0,
    rows: [],
    confirmReset: false
  },

  onInit() {
    var total = parseInt(this.total, 10) || 0
    var learned = parseInt(this.learned, 10) || 0
    var seen = parseInt(this.seen, 10) || 0
    this.fill = total ? Math.round((BAR_WIDTH * learned) / total) : 0
    var rows = [
      { label: 'Seen', value: seen },
      { label: 'New', value: Math.max(0, total - seen) },
      { label: 'Due now', value: parseInt(this.due, 10) || 0 },
      { label: 'Mastered', value: parseInt(this.mastered, 10) || 0 }
    ]
    var boxes = String(this.boxes || '').split(',')
    for (var b = 0; b < boxes.length; b++) {
      if (boxes[b] === '') continue
      rows.push({ label: b === 0 ? 'Box 0 (again)' : 'Box ' + b, value: parseInt(boxes[b], 10) || 0 })
    }
    var answered = parseInt(this.quizAnswered, 10) || 0
    var correct = parseInt(this.quizCorrect, 10) || 0
    rows.push({ label: 'Quiz answers', value: answered })
    rows.push({ label: 'Quiz accuracy', value: answered ? Math.round((100 * correct) / answered) + '%' : '–' })
    rows.push({ label: 'Best streak', value: parseInt(this.quizBest, 10) || 0 })
    this.rows = rows
    this.resetTimer = null
  },

  resetProgress() {
    var self = this
    if (!this.confirmReset) {
      this.confirmReset = true
      this.resetTimer = setTimeout(function () { self.confirmReset = false }, 2500)
      return
    }
    clearTimeout(this.resetTimer)
    this.confirmReset = false
    // The card page reloads progress from storage when it is shown again.
    function deleteProgress() {
      storage.delete({
        key: STORAGE_KEY,
        success: function () { router.back() },
        fail: function () { router.back() }
      })
    }
    storage.delete({ key: QUIZ_KEY, success: deleteProgress, fail: deleteProgress })
  },

  chooseCards() {
    this.chooseMode('cards')
  },

  chooseQuiz() {
    this.chooseMode('quiz')
  },

  // Saves the mode and goes back to the card page, which reads it when it is shown again.
  chooseMode(mode) {
    storage.set({
      key: MODE_KEY,
      value: mode,
      success: function () { router.back() },
      fail: function () { router.back() }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 22px 8px 0 8px;
}

.back {
  height: 48px;
  margin-bottom: 6px;
  border-radius: 24px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}

.back-label {
  font-size: 22px;
  color: #ffb340;
}

.modes {
  height: 48px;
  margin-bottom: 6px;
  flex-direction: row;
  justify-content: space-between;
}

.mode {
  width: 86px;
  height: 48px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}

.mode-on {
  background-color: #bf5af2;
}

.mode-label {
  font-size: 20px;
  color: #ffffff;
}

.list {
  flex: 1;
  flex-direction: column;
}

.head-item {
  flex-direction: column;
  align-items: center;
  padding: 6px 0 14px 0;
}

.big {
  font-size: 44px;
  font-weight: bold;
  color: #32d74b;
}

.sub {
  font-size: 17px;
  color: #aeaeb2;
  text-align: center;
}

.bar {
  width: 160px;
  height: 10px;
  margin-top: 10px;
  border-radius: 5px;
  background-color: #2c2c2e;
}

.fill {
  height: 10px;
  border-radius: 5px;
  background-color: #32d74b;
}

.row {
  height: 40px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 8px;
}

.row-label {
  font-size: 19px;
  color: #d1d1d6;
}

.row-value {
  font-size: 19px;
  color: #ffffff;
  font-weight: bold;
}

.reset-item {
  padding: 16px 0 0 0;
}

.reset {
  width: 100%;
  height: 52px;
  border-radius: 20px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}

.warn {
  background-color: #ff453a;
}

.reset-label {
  font-size: 18px;
  color: #ffffff;
  text-align: center;
}

.end-item {
  height: 60px;
}

.end {
  font-size: 12px;
}
</style>
