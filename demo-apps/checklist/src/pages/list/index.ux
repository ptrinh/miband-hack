<template>
  <div class="page">
    <div class="top">
      <div class="back" onclick="goBack">
        <text class="back-label">‹ Back</text>
      </div>
      <text class="count {{total > 0 && done === total ? 'count-done' : ''}}">{{done}}/{{total}}</text>
    </div>
    <list class="list">
      <list-item type="title" class="title-item">
        <text class="title">{{title}}</text>
      </list-item>
      <list-item type="empty" class="empty-item" if="{{state !== 'ready' || rows.length === 0}}">
        <text class="info">{{state === 'loading' ? 'Loading…' : state === 'missing' ? 'List not found' : 'No items'}}</text>
      </list-item>
      <list-item type="row" class="row {{it.done ? 'row-done' : ''}}" for="{{(i, it) in rows}}" onclick="toggle(i)">
        <div class="box {{it.done ? 'box-on' : ''}}">
          <div class="mark {{it.done ? 'mark-on' : ''}}"></div>
        </div>
        <text class="text {{it.done ? 'text-done' : ''}}">{{it.text}}</text>
      </list-item>
      <list-item type="reset" class="reset-item" if="{{done > 0}}">
        <div class="reset {{confirmReset ? 'warn' : ''}}" onclick="uncheckAll">
          <text class="reset-label {{confirmReset ? 'reset-label-warn' : ''}}">{{confirmReset ? 'Tap again' : 'Uncheck all'}}</text>
        </div>
      </list-item>
      <list-item type="end" class="end-item">
        <text class="end"> </text>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import { loadLists, loadTicks, saveTicks } from '../../common/data.js'
import { countDone, findList, rows, toggle, uncheckAll } from '../../common/model.js'

var CONFIRM_MS = 3000 // "Tap again" falls back to "Uncheck all" after this

export default {
  // router params
  protected: {
    id: ''
  },

  private: {
    state: 'loading', // loading | ready | missing | error
    title: '',
    rows: [],
    done: 0,
    total: 0,
    confirmReset: false
  },

  onInit() {
    var self = this
    this.list = null
    this.ticks = {}
    this.confirmTimer = 0
    loadLists(function (err, lists) {
      var list = findList(lists, String(self.id))
      if (!list) {
        self.state = err ? 'error' : 'missing'
        self.title = err ? 'Cannot read lists' : ''
        return
      }
      self.list = list
      self.title = list.title
      self.total = list.items.length
      loadTicks(function (ticks) {
        self.ticks = ticks
        self.rows = rows(list, ticks)
        self.done = countDone(list, ticks)
        self.state = 'ready'
      })
    })
  },

  onDestroy() {
    this.cancelConfirm()
  },

  toggle(i) {
    var row = this.rows[i]
    if (!row || !this.list) return
    this.cancelConfirm()
    row.done = toggle(this.ticks, this.list.id, row.id)
    this.done = countDone(this.list, this.ticks)
    saveTicks(this.ticks)
  },

  // First tap arms, a second tap within CONFIRM_MS unchecks every item of this list.
  uncheckAll() {
    var self = this
    if (!this.list) return
    if (!this.confirmReset) {
      this.confirmReset = true
      this.confirmTimer = setTimeout(function () {
        self.confirmTimer = 0
        self.confirmReset = false
      }, CONFIRM_MS)
      return
    }
    this.cancelConfirm()
    uncheckAll(this.ticks, this.list.id)
    saveTicks(this.ticks)
    for (var i = 0; i < this.rows.length; i++) this.rows[i].done = false
    this.done = 0
  },

  cancelConfirm() {
    if (this.confirmTimer) clearTimeout(this.confirmTimer)
    this.confirmTimer = 0
    this.confirmReset = false
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 22px 8px 0 12px;
}

.top {
  height: 48px;
  margin-bottom: 6px;
  align-items: center;
}

.back {
  width: 112px;
  height: 48px;
  border-radius: 24px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}

.back-label {
  font-size: 22px;
  color: #30d158;
}

.count {
  flex: 1;
  font-size: 22px;
  color: #8a8a8e;
  text-align: right;
  padding-right: 4px;
}

.count-done {
  color: #30d158;
}

.list {
  flex: 1;
  flex-direction: column;
}

.title-item {
  padding: 2px 4px 8px 4px;
}

.title {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
}

.empty-item {
  padding: 24px 4px;
  justify-content: center;
}

.info {
  font-size: 20px;
  color: #8a8a8e;
  text-align: center;
}

.row {
  min-height: 56px;
  margin-bottom: 6px;
  padding: 8px 8px 8px 8px;
  border-radius: 14px;
  background-color: #1f1f22;
  align-items: center;
}

.row-done {
  background-color: #141416;
}

.box {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  border-width: 3px;
  border-style: solid;
  border-color: #8a8a8e;
  justify-content: center;
  align-items: center;
}

.box-on {
  border-color: #30d158;
  background-color: #30d158;
}

.mark {
  width: 10px;
  height: 10px;
  border-radius: 5px;
}

.mark-on {
  background-color: #000000;
}

.text {
  flex: 1;
  margin-left: 8px;
  font-size: 19px;
  color: #ffffff;
}

.text-done {
  color: #6e6e73;
  text-decoration: line-through;
}

.reset-item {
  padding-top: 10px;
}

.reset {
  flex: 1;
  height: 52px;
  border-radius: 26px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}

.warn {
  background-color: #ff453a;
}

.reset-label {
  font-size: 20px;
  text-align: center;
  color: #ff9f0a;
}

.reset-label-warn {
  color: #ffffff;
}

.end-item {
  height: 60px;
}

.end {
  font-size: 12px;
}
</style>
